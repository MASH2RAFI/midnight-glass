#!/bin/bash
# Omarchy post-boot hook: ensure Midnight Glass waybar layout after login.
# Installed by ./install-integration.sh into ~/.config/omarchy/hooks/post-boot.d/

set -euo pipefail

THEME_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/themes/midnight-glass"
THEME_NAME_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/current/theme.name"

[[ -f $THEME_NAME_FILE ]] || exit 0
[[ $(tr '[:upper:]' '[:lower:]' <"$THEME_NAME_FILE") == "midnight-glass" ]] || exit 0

# Hyprland autostart may launch waybar before hooks run.
sleep 1
"$THEME_DIR/sync-waybar-layout.sh" >/dev/null 2>&1 || true
