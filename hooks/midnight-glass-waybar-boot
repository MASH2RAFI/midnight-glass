#!/bin/bash
# Omarchy post-boot hook: ensure Midnight Glass waybar layout after login.

set -euo pipefail

MG_ROOT="${MG_THEME_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/themes/midnight-glass}"
# shellcheck source=lib/common.sh
source "$MG_ROOT/lib/common.sh"

mg_is_active || exit 0

for _ in 1 2 3 4 5; do
  pgrep -x waybar >/dev/null 2>&1 && break
  sleep 0.2
done
pgrep -x waybar >/dev/null 2>&1 || exit 0
"$THEME_DIR/sync-waybar-layout.sh" >/dev/null 2>&1 || true
