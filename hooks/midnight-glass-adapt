#!/bin/bash
# Omarchy theme-set hook for Midnight Glass.

set -euo pipefail

MG_ROOT="${MG_THEME_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/themes/midnight-glass}"
# shellcheck source=lib/common.sh
source "$MG_ROOT/lib/common.sh"

THEME="${1,,}"

if [[ $THEME != "$MG_THEME_SLUG" ]]; then
  mg_deactivate_all >/dev/null 2>&1 || true
  exit 0
fi

[[ ${MIDNIGHT_GLASS_ADAPTING:-} == 1 ]] && exit 0

export MIDNIGHT_GLASS_ADAPTING=1
mg_start_watcher
"$THEME_DIR/adapt-from-wallpaper.sh"
if [[ -f $THEME_DIR/.nautilus-swap-active ]]; then
  "$THEME_DIR/manage-nautilus-config.sh" refresh >/dev/null 2>&1 || true
else
  "$THEME_DIR/apply-nautilus-theme.sh" >/dev/null 2>&1 || true
fi
"$THEME_DIR/sync-waybar-layout.sh" >/dev/null
"$THEME_DIR/sync-theme-assets.sh"
unset MIDNIGHT_GLASS_ADAPTING
