#!/bin/bash
# Watch wallpaper changes and re-adapt Midnight Glass colors automatically.
# Installed by ./install-integration.sh as a systemd user service.

set -euo pipefail

THEME_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/themes/midnight-glass"
BG_LINK="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/current/background"
THEME_NAME_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/current/theme.name"
LAST=""

while true; do
  if [[ -f $THEME_NAME_FILE ]] && [[ $(tr '[:upper:]' '[:lower:]' <"$THEME_NAME_FILE") == "midnight-glass" ]]; then
    CUR=$(readlink -f "$BG_LINK" 2>/dev/null || true)
    if [[ -n $CUR && -f $CUR && $CUR != "$LAST" ]]; then
      LAST=$CUR
      export MIDNIGHT_GLASS_ADAPTING=1
      "$THEME_DIR/adapt-from-wallpaper.sh" "$CUR" || true
      "$THEME_DIR/sync-theme-assets.sh" || true
      unset MIDNIGHT_GLASS_ADAPTING
    fi
  fi
  sleep 2
done
